# ====================================================================
# FixMyCampus - Environment Configuration Template
# ====================================================================
# Copy this file to .env or configure these variables in your hosting
# provider (e.g. Render, Railway, AWS, Docker) or local server.

# --------------------------------------------------------------------
# 1. Database Configuration (MySQL / MariaDB)
# --------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fixmycampus
DB_USER=root
DB_PASSWORD=

# --------------------------------------------------------------------
# 2. Application Base URL (Auto-detected if omitted)
# --------------------------------------------------------------------
BASE_URL=http://localhost/fixmycampus/

# --------------------------------------------------------------------
# 3. Cloudinary Media Storage (Optional - Local storage used if blank)
# --------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# --------------------------------------------------------------------
# 4. Google Gemini AI API (Optional - Smart Voice & Chat Extraction)
# --------------------------------------------------------------------
GEMINI_API_KEY=
